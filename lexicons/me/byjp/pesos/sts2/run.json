{
	"lexicon": 1,
	"id": "me.byjp.pesos.sts2.run",
	"defs": {
		"main": {
			"type": "record",
			"description": "A single Slay the Spire 2 run.",
			"key": "tid",
			"record": {
				"type": "object",
				"properties": {
					"outcome": {
						"type": "string",
						"description": "How the run ended.",
						"knownValues": [
							"in_progress",
							"victory",
							"death",
							"abandoned"
						]
					},
					"character": {
						"type": "string",
						"description": "Character class id (e.g. 'ironclad', 'silent')."
					},
					"ascension": {
						"type": "integer",
						"minimum": 0,
						"maximum": 20
					},
					"seed": {
						"type": "string",
						"description": "Run seed as displayed in-game."
					},
					"floor": {
						"type": "integer",
						"minimum": 0
					},
					"act": {
						"type": "integer",
						"minimum": 1,
						"maximum": 4
					},
					"score": {
						"type": "integer",
						"minimum": 0
					},
					"steamID64": {
						"type": "string",
						"description": "SteamID64 of the run's owner, when playing on Steam."
					},
					"killedBy": {
						"type": "string",
						"description": "Enemy / event that ended the run, if applicable."
					},
					"startedAt": {
						"type": "string",
						"format": "datetime"
					},
					"endedAt": {
						"type": "string",
						"format": "datetime"
					},
					"durationSeconds": {
						"type": "integer",
						"minimum": 0
					},
					"deck": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Card ids in the final deck."
					},
					"relics": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Relic ids held at run end."
					},
					"potions": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Potion ids currently held."
					},
					"allies": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"steam": {
									"type": "string",
									"description": "SteamID64 as a decimal string."
								},
								"atproto": {
									"type": "string",
									"format": "did",
									"description": "Atproto DID, when known."
								}
							},
							"required": [
								"steam"
							]
						},
						"description": "Other players in a multiplayer run."
					},
					"stats": {
						"type": "ref",
						"ref": "lex:me.byjp.pesos.sts2.run#stats",
						"description": "Aggregated combat stats across the run. All fields optional; counters reflect the local player's own activity."
					},
					"game": {
						"type": "string",
						"format": "at-uri",
						"description": "Optional at-uri of the canonical games.gamesgamesgamesgames.actor.game record for StS2."
					},
					"statsRef": {
						"type": "string",
						"format": "at-uri",
						"description": "at-uri of the user's games.gamesgamesgamesgames.actor.stats record for StS2, updated alongside this run."
					},
					"modVersion": {
						"type": "string"
					},
					"gameVersion": {
						"type": "string"
					},
					"updatedAt": {
						"type": "string",
						"format": "datetime"
					}
				},
				"required": [
					"outcome",
					"character",
					"ascension",
					"seed",
					"startedAt",
					"updatedAt"
				]
			}
		},
		"stats": {
			"type": "object",
			"properties": {
				"combats": {
					"type": "integer",
					"minimum": 0,
					"description": "Total combats entered."
				},
				"combatsWon": {
					"type": "integer",
					"minimum": 0,
					"description": "Combats the player's side won."
				},
				"elitesWon": {
					"type": "integer",
					"minimum": 0,
					"description": "Elite combats won."
				},
				"bossesWon": {
					"type": "integer",
					"minimum": 0,
					"description": "Boss combats won."
				},
				"turns": {
					"type": "integer",
					"minimum": 0,
					"description": "Total player turns taken across all combats."
				},
				"longestCombat": {
					"type": "integer",
					"minimum": 0,
					"description": "Most player turns in a single combat."
				},
				"damageDealt": {
					"type": "integer",
					"minimum": 0,
					"description": "Total unblocked HP damage dealt by the player to enemies."
				},
				"damageTaken": {
					"type": "integer",
					"minimum": 0,
					"description": "Total unblocked HP damage taken by the player."
				},
				"biggestSingleHit": {
					"type": "integer",
					"minimum": 0,
					"description": "Largest single unblocked hit dealt by the player."
				},
				"biggestTurnDamage": {
					"type": "integer",
					"minimum": 0,
					"description": "Most damage the player dealt in one player turn."
				},
				"biggestTurnDamageTaken": {
					"type": "integer",
					"minimum": 0,
					"description": "Most damage the player took in one enemy turn."
				},
				"cardsPlayed": {
					"type": "integer",
					"minimum": 0
				},
				"cardsDrawn": {
					"type": "integer",
					"minimum": 0
				},
				"cardsExhausted": {
					"type": "integer",
					"minimum": 0
				},
				"potionsUsed": {
					"type": "integer",
					"minimum": 0
				},
				"noDamageTurns": {
					"type": "integer",
					"minimum": 0,
					"description": "Enemy turns during which the player took zero unblocked damage."
				},
				"highestBlockInTurn": {
					"type": "integer",
					"minimum": 0,
					"description": "Most block gained by the player in a single player turn."
				}
			}
		}
	}
}
